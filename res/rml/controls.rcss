button,
select-button {
    color: var(--button-color);
    background-color: var(--button-background);
    opacity: 0.9;
    padding: var(--space-sm) var(--space-lg);
    border-radius: var(--radius-control);
    box-shadow: var(--control-outline);
    decorator: var(--selection-gradient-rest);
    transition: decorator 0.15s linear-in-out, background-color 0.1s linear-in-out, opacity 0.1s linear-in-out;
}

button {
    text-align: center;
    font-size: var(--font-size-2xl);
}

button:not(:disabled):hover,
button:not(:disabled):focus-visible,
select-button:not(:disabled):hover,
select-button:not(:disabled):focus-visible {
    opacity: 1;
    background-color: var(--button-background-hover);
    box-shadow: var(--control-outline-focus);
    decorator: var(--selection-gradient);
}

button:not(:disabled):selected,
select-button:not(:disabled):selected {
    opacity: 1;
    background-color: var(--button-background-selected);
    decorator: var(--selection-gradient-selected);
}

button:not(:disabled):selected:hover,
button:not(:disabled):selected:focus-visible,
select-button:not(:disabled):selected:hover,
select-button:not(:disabled):selected:focus-visible {
    background-color: var(--button-background-selected-focus);
    box-shadow: var(--control-outline-focus);
    decorator: var(--selection-gradient-selected-focus);
}

button:not(:disabled):active,
select-button:not(:disabled):active {
    opacity: 1;
    background-color: var(--button-background-active);
    box-shadow: var(--control-outline-focus);
    decorator: var(--selection-gradient-active);
}

button:disabled,
select-button:disabled {
    opacity: 0.35;
    cursor: default;
}

select-button {
    display: flex;
    position: relative;
    align-items: center;
    gap: var(--space-sm);
}

select-button key,
select-button value {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

select-button key {
    font-family: var(--font-family-heading);
    font-weight: bold;
    font-size: var(--font-size-xl);
    letter-spacing: var(--letter-spacing-heading);
    text-transform: uppercase;
    flex: 0 1 auto;
}

select-button value {
    flex: 1 0 20%;
    text-align: right;
    font-size: var(--font-size-2xl);
    color: var(--color-value);
}

select-button value.modified {
    font-weight: bold;
    color: var(--color-value-modified);
}

select-button input {
    position: absolute;
    top: var(--space-sm);
    right: var(--space-lg);
    width: 55%;
    text-align: right;
    font-size: var(--font-size-2xl);
    color: var(--color-white);
}

select-button icon {
    display: none;
    flex: 0 0 auto;
}

select-button.has-icon icon,
select-button.group-button icon {
    display: inline-block;
}

select-button.has-icon > icon {
    color: var(--color-warning);
}

select-button.group-button > icon {
    flex: 0 0 24dp;
    margin-left: auto;
    width: 24dp;
    height: 24dp;
    font-size: var(--font-size-4xl);
    color: var(--color-accent);
    decorator: text("&#xe5cc;" center center);
}

select-button.group-button value {
    display: none;
}

select-button.dropdown-button icon {
    display: none;
}

select-button.dropdown-button dropdown-indicator {
    display: block;
    flex: 0 0 16dp;
    width: 16dp;
    height: 16dp;
    font-family: var(--font-family-icons);
    font-size: 16dp;
    font-weight: normal;
    line-height: 1;
    color: var(--color-accent);
    transition: transform 0.1s linear-in-out;
}

select-button.dropdown-button.expanded dropdown-indicator {
    transform: rotate(180deg);
}

button.compact,
select-button.compact {
    padding: 6dp var(--space-md);
    font-size: var(--font-size-sm);
}

select-button.compact key {
    font-size: var(--font-size-xs);
}

select-button.compact value,
select-button.compact input {
    font-size: var(--font-size-sm);
}

button.with-icon {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
}

button.with-icon icon {
    flex-shrink: 0;
    font-size: 1.25em;
    line-height: 1;
}

button.primary {
    --button-background: rgba(var(--color-interactive-rgb), 18%);
    --button-background-hover: rgba(var(--color-interactive-rgb), 36%);
    --button-background-selected: rgba(var(--color-interactive-rgb), 24%);
    --button-background-selected-focus: rgba(var(--color-interactive-rgb), 44%);
    --button-background-active: rgba(var(--color-interactive-rgb), 55%);
    box-shadow: rgba(var(--color-accent-rgb), 65%) 0 0 0 var(--border-width);
}

button.overlay {
    --button-background: rgba(var(--color-surface-rgb), 80%);
    --button-background-hover: rgba(var(--color-control-rgb), 90%);
    --button-background-selected: rgba(var(--color-control-rgb), 90%);
    --button-background-selected-focus: rgba(var(--color-control-rgb), 90%);
    --button-background-active: rgba(var(--color-surface-rgb), 90%);
    box-shadow: rgba(var(--color-border-rgb), 60%) 0 0 0 var(--border-width);
}

button.danger {
    box-shadow: rgba(var(--color-error-rgb), 55%) 0 0 0 var(--border-width);
}

button.icon-button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44dp;
    height: 44dp;
    padding: var(--space-sm);
    box-sizing: border-box;
    flex-shrink: 0;
    font-size: var(--font-size-5xl);
}

button.icon-button,
button.icon-button:not(:disabled):hover,
button.icon-button:not(:disabled):focus-visible,
button.icon-button:not(:disabled):active {
    decorator: none;
}

button.icon-button:not(:disabled):hover,
button.icon-button:not(:disabled):focus-visible {
    color: var(--color-white);
    box-shadow: var(--focus-ring);
}

button.icon-button icon {
    display: block;
    flex-shrink: 0;
    line-height: 1;
    pointer-events: none;
}

button.icon-button.compact {
    width: 30dp;
    height: 28dp;
    padding: 0;
    font-size: var(--font-size-md);
}
