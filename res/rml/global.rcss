*, *:before, *:after {
    box-sizing: border-box;
}

b {
    font-weight: bold;
}

p,
heading,
text-list,
text-list item,
file-path {
    display: block;
}

heading {
    font-weight: bold;
    line-height: 1.3;
}

small,
file-path,
status-badge {
    font-size: var(--font-size-sm);
    font-weight: normal;
    line-height: 1.4;
    color: rgba(var(--color-text-rgb), 62%);
}

file-path {
    display: block;
}

ui-row {
    display: flex;
    flex-flow: row;
    align-items: center;
    gap: var(--space-sm);
    min-width: 0;
    focus: none;
}

ui-row > * {
    flex: 0 1 auto;
    min-width: 0;
}

button,
select-button {
    cursor: pointer;
    focus: auto;
}

button.danger {
    color: var(--color-error);
}

icon {
    width: 1em;
    height: 1em;
    font-family: var(--font-family-icons);
    font-weight: normal;
    line-height: 1;
    display: inline-block;
    vertical-align: middle;
}

icon.warning {
    decorator: text("&#xe002;" center center);
}

icon.question-mark {
    decorator: text("&#xeb8b;" center center);
}

icon.error {
    decorator: text("&#xe000;" center center);
}

icon.verifying {
    decorator: text("&#xe8b5;" center center);
}

icon.download {
    decorator: text("&#xe2c4;" center center);
}

icon.celebration {
    decorator: text("&#xea65;" center center);
}

icon.arrow-forward {
    decorator: text("&#xe5c8;" center center);
}

icon.trophy {
    decorator: text("&#xe71a;" center center);
}

icon.controller {
    decorator: text("&#xf135;" center center);
}

icon.download-done {
    decorator: text("&#xf091;" center center);
}

status-badge.success {
    color: var(--color-success);
}

status-badge.error {
    color: var(--color-error);
}

status-badge.warning {
    color: var(--color-warning);
}

status-badge.info {
    color: var(--color-info);
}

progress {
    display: block;
    width: 100%;
    height: 6dp;
    border-radius: 3dp;
    background-color: rgba(var(--color-white-rgb), 10%);
}

progress fill {
    background-color: rgba(var(--color-accent-rgb), 80%);
    border-radius: 3dp;
}

progress.success fill,
progress.installed fill {
    background-color: var(--color-success);
}

progress.info fill,
progress.installing fill {
    background-color: rgba(var(--color-info-rgb), 80%);
}

progress.failed fill {
    background-color: var(--color-error);
}

progress.paused fill {
    background-color: rgba(var(--color-text-rgb), 35%);
}

progress.retrying fill {
    background-color: rgba(var(--color-warning-rgb), 55%);
}

scrollbarvertical {
    width: var(--scrollbar-width);
    margin: var(--space-sm) var(--space-xs) var(--space-sm) 0;
}

scrollbarvertical sliderarrowdec,
scrollbarvertical sliderarrowinc {
    width: 0;
    height: 0;
}

scrollbarvertical slidertrack {
    width: var(--scrollbar-width);
    background-color: rgba(var(--color-accent-rgb), 8%);
    border-radius: var(--radius-small);
}

scrollbarvertical sliderbar {
    width: var(--scrollbar-width);
    min-height: 24dp;
    background-color: rgba(var(--color-accent-rgb), 45%);
    border-radius: var(--radius-small);
    transition: background-color 0.2s cubic-in-out;
}

scrollbarvertical sliderbar:hover,
scrollbarvertical sliderbar:active {
    background-color: rgba(var(--color-accent-rgb), 80%);
}

ui-tooltip {
    display: none;
    position: absolute;
    z-index: 1000;
    max-width: 240dp;
    font-family: var(--font-family-body);
    font-weight: normal;
    padding: 6dp 10dp;
    border-width: var(--border-width);
    border-color: var(--panel-border);
    border-radius: var(--radius-panel);
    background-color: rgba(var(--color-surface-rgb), 96%);
    box-shadow: var(--panel-glow);
    color: var(--color-text);
    font-size: var(--font-size-md);
    word-break: break-word;
    pointer-events: none;
    focus: none;
}

ui-tooltip.visible {
    display: block;
}
