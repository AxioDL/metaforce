tab-bar {
    display: flex;
    position: relative;
    min-width: 0;
    overflow: auto hidden;
    clip: always;
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-heading);
}

tab-bar scrollbarhorizontal,
tab-bar scrollbarhorizontal sliderarrowdec,
tab-bar scrollbarhorizontal sliderarrowinc,
tab-bar scrollbarhorizontal slidertrack,
tab-bar scrollbarhorizontal sliderbar {
    width: 0;
    height: 0;
}

tab-bar tab {
    flex: 0 0 auto;
    padding: 0 var(--space-xl);
    line-height: var(--toolbar-height);
    white-space: nowrap;
    decorator: vertical-gradient(rgba(var(--color-accent-rgb), 0%) rgba(var(--color-accent-rgb), 0%));
    transition: decorator 0.1s linear-in-out, opacity 0.1s linear-in-out;
    cursor: pointer;
}

tab-bar tab:selected {
    opacity: 1;
    color: var(--color-white);
    border-bottom-width: 3dp;
    border-bottom-color: var(--color-accent);
    font-effect: glow(0dp 6dp 0dp 0dp rgba(var(--color-accent-rgb), 55%));
    decorator: vertical-gradient(rgba(var(--color-accent-rgb), 0) rgba(var(--color-accent-rgb), 18%));
}

tab-bar tab:focus-visible,
tab-bar tab:hover {
    opacity: 1;
    font-effect: glow(0dp 6dp 0dp 0dp rgba(var(--color-accent-rgb), 55%));
    decorator: vertical-gradient(rgba(var(--color-accent-rgb), 0) rgba(var(--color-accent-rgb), 32%));
}

tab-bar tab:active {
    decorator: vertical-gradient(rgba(var(--color-accent-rgb), 12%) rgba(var(--color-accent-rgb), 50%));
}

tab-bar[closable] tab-end-spacer {
    display: block;
    flex: 0 0 var(--toolbar-height);
    width: var(--toolbar-height);
    pointer-events: none;
}

tab-bar[closable] close,
window > close {
    display: block;
    position: fixed;
    top: 8dp;
    right: 8dp;
    z-index: 2;
    width: 48dp;
    height: 48dp;
    font-family: var(--font-family-icons);
    font-weight: normal;
    font-size: var(--font-size-4xl);
    color: rgba(var(--color-text-rgb), 70%);
    border-radius: var(--radius-control);
    decorator: text("&#xe5cd;" center center);
    transition: color background-color 0.12s linear-in-out;
    cursor: pointer;
}

tab-bar[closable] close:hover,
tab-bar[closable] close:focus-visible,
window > close:hover,
window > close:focus-visible {
    color: var(--color-white);
    background-color: rgba(var(--color-accent-rgb), 24%);
    box-shadow: var(--focus-ring);
}

window > close {
    top: 16dp;
    right: 16dp;
}

tab-bar[closable] close:active,
window > close:active {
    color: var(--color-white);
    background-color: rgba(var(--color-accent-rgb), 40%);
}
