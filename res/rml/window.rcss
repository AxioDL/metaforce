body {
    display: flex;
    width: 100%;
    height: 100%;
    padding: 64dp;
    font-family: var(--font-family-body);
    font-weight: normal;
    font-style: normal;
    font-size: var(--font-size-base);
    color: var(--color-text);
}

window {
    display: flex;
    flex-flow: column;
    position: relative;
    height: 100%;
    width: 100%;
    max-width: var(--window-max-width);
    max-height: var(--window-max-height);
    margin: auto;
    border-radius: var(--radius-window);
    overflow: hidden;
    border-width: var(--border-width);
    border-color: var(--panel-border);
    backdrop-filter: var(--panel-backdrop);
    box-shadow: var(--panel-glow), rgba(var(--color-black-rgb), 60%) 0 12dp 40dp 0;
    background-color: var(--panel-background);
    decorator: var(--panel-scanlines);
    filter: opacity(0);
    transform: scale(0.96);
    transform-origin: center;
    transition: filter transform 0.2s cubic-in-out;
}

window.small {
    height: auto;
    width: auto;
}

window.modal {
    max-width: var(--modal-max-width);
}

@media (max-height: 896dp) {
    window.modal {
        max-height: 100%;
    }
}

window[open] {
    filter: opacity(1);
    transform: scale(1);
}

@media (max-height: 640dp) {
    body {
        padding: var(--space-lg);
    }
    window {
        box-shadow: none;
    }
}

@media (max-width: 768dp) {
    body {
        padding: var(--space-lg);
    }
    window.modal {
        width: 100%;
        max-width: 100%;
    }
}

window tab-bar {
    flex: 0 0 var(--toolbar-height);
    height: var(--toolbar-height);
    background-color: rgba(var(--color-accent-rgb), 6%);
    font-family: var(--font-family-heading);
    font-weight: bold;
    font-size: var(--font-size-2xl);
    border-bottom-width: var(--border-width);
    border-bottom-color: var(--panel-border);
}

window tab-bar tab {
    opacity: 0.4;
}

window content {
    display: flex;
    flex: 1 1 auto;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
}

window content pane {
    display: flex;
    flex-flow: column;
    flex: 1 1 0;
    min-width: 0;
    min-height: 0;
    padding: var(--space-xl);
    gap: var(--space-sm);
    overflow: hidden auto;
    font-size: var(--font-size-2xl);
}

window content pane:not(:last-of-type) {
    border-right-width: var(--border-width);
    border-right-color: var(--color-rule);
}

window content pane:last-of-type {
    color: rgba(var(--color-text-rgb), 85%);
}

window content pane > * {
    flex: 0 0 auto;
}

ui-list {
    display: flex;
    flex-flow: column;
    flex: 1 1 0;
    min-width: 0;
    min-height: 0;
}

window content pane > ui-list,
modal-content pane > ui-list {
    flex: 1 1 0;
    min-width: 0;
    min-height: 0;
}

ui-list-viewport {
    display: block;
    flex: 1 1 0;
    min-width: 0;
    min-height: 0;
    overflow: hidden auto;
}

ui-list-content {
    display: flex;
    flex-flow: column;
    gap: var(--space-sm);
    min-width: 0;
}

ui-list-content > button.ui-list-row {
    flex: 0 0 auto;
    contain: paint;
}

ui-list-empty {
    display: block;
    padding: var(--space-lg);
    text-align: center;
    opacity: 0.45;
}

window content pane > ui-list {
    margin-left: -24dp;
    margin-right: -24dp;
}

window content pane > ui-list:first-child {
    margin-top: -24dp;
}

window content pane > ui-list:last-child {
    margin-bottom: -24dp;
}

window content pane > ui-list ui-list-content,
window content pane > ui-list ui-list-empty {
    padding-left: var(--space-xl);
    padding-right: var(--space-xl);
}

window content pane > ui-list:first-child ui-list-content,
window content pane > ui-list:first-child ui-list-empty {
    padding-top: var(--space-xl);
}

window content pane > ui-list:last-child ui-list-content,
window content pane > ui-list:last-child ui-list-empty {
    padding-bottom: var(--space-xl);
}

window content pane:last-of-type > div {
    line-height: 1.625;
}

scrollbarhorizontal {
    height: 0;
}

scrollbarhorizontal sliderarrowdec,
scrollbarhorizontal sliderarrowinc {
    width: 0;
    height: 0;
}

scrollbarhorizontal slidertrack,
scrollbarhorizontal sliderbar {
    width: 0;
    height: 0;
}

section-heading {
    font-family: var(--font-family-heading);
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-section);
    font-size: var(--font-size-lg);
    color: var(--color-heading);
    padding-bottom: var(--space-xs);
    border-bottom-width: var(--border-width);
    border-bottom-color: var(--color-rule);
}

section-heading:not(:first-of-type) {
    margin-top: var(--space-md);
}

button.modal-btn {
    flex: 1 1 0;
    text-align: center;
}

modal-actions icon {
    margin-right: var(--space-xs);
}

modal-dialog {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: var(--space-xl);
    gap: 20dp;
    flex: 0 1 auto;
    min-height: 0;
    width: 100%;
    overflow: hidden;
    text-align: left;
}

window.modal.danger {
    border-color: var(--color-danger-border);
    box-shadow: rgba(var(--color-error-rgb), 18%) 0 0 28dp 2dp, rgba(var(--color-black-rgb), 60%) 0 12dp 40dp 0;
    decorator: linear-gradient(180deg, rgba(var(--color-error-rgb), 20%), rgba(var(--color-error-rgb), 0%) 70%), var(--panel-scanlines);
}

modal-header {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    flex: 0 0 auto;
    gap: var(--space-lg);
}

modal-header icon {
    font-size: var(--font-size-4xl);
    color: var(--color-heading);
}

modal-title {
    display: block;
    font-family: var(--font-family-heading);
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-section);
    font-size: var(--font-size-2xl);
    color: var(--color-heading);
    flex: 1 1 auto;
}

window.modal.danger modal-title,
window.modal.danger modal-header icon {
    color: var(--color-danger-heading);
}

modal-body {
    display: block;
    width: 100%;
    flex: 0 0 auto;
    min-width: 0;
    font-size: var(--font-size-2xl);
    color: var(--color-white);
    font-weight: normal;
}

modal-body modal-tip {
    font-size: var(--font-size-sm);
    color: rgba(var(--color-text-rgb), 60%);
}

modal-content {
    display: none;
    width: 100%;
    flex: 1 1 auto;
    min-height: 0;
    overflow: hidden;
}

modal-content.active {
    display: flex;
    flex-direction: column;
}

modal-content pane {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    min-height: 0;
    width: 100%;
    gap: var(--space-sm);
    overflow: hidden auto;
}

modal-content pane > * {
    flex: 0 0 auto;
}

modal-actions {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: stretch;
    gap: var(--space-md);
    width: 100%;
    flex: 0 0 auto;
    padding-top: var(--space-xs);
}

modal-actions.vertical {
    flex-direction: column;
    align-items: stretch;
}

modal-actions.vertical button.modal-btn {
    flex: 0 0 auto;
    width: 100%;
}

@media (max-height: 640dp) {
    modal-dialog {
        padding: var(--space-lg);
        gap: var(--space-md);
    }

    modal-body {
        font-size: var(--font-size-lg);
    }
}

@media (max-width: 640dp) {
    modal-actions {
        flex-direction: column;
    }

    modal-actions button.modal-btn {
        flex: 0 0 auto;
        width: 100%;
    }
}
